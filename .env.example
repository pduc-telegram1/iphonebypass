# Cấu hình Telegram Bot
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
# ID của Channel hoặc Group để bot tự động đăng bài hàng ngày
# Nếu là channel public, điền @username_channel (ví dụ: @mychannel)
# Nếu là channel/group private, điền ID dạng số (ví dụ: -100123456789)
TELEGRAM_CHANNEL_ID="@your_channel_username"

# Đường dẫn đến file chứa JSON credentials của Google Cloud Service Account
GOOGLE_CREDENTIALS_FILE="credentials.json"
# Tên của Google Sheet (hoặc ID)
GOOGLE_SHEET_NAME="Tên_file_Google_Sheet_Của_Bạn"
# Tên trang tính (sheet name) bên trong file, ví dụ: Sheet1
GOOGLE_WORKSHEET_NAME="Sheet1"

# Thời gian tự động đăng bài (giờ và phút) theo múi giờ Việt Nam (Asia/Ho_Chi_Minh)
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
